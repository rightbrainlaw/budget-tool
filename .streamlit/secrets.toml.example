# Copy this file to `.streamlit/secrets.toml` and fill in the real values.
# secrets.toml itself is git-ignored — it never gets committed.

[supabase]
# Supabase dashboard -> Project Settings -> API
url = "https://YOUR-PROJECT-REF.supabase.co"
anon_key = "YOUR-ANON-PUBLIC-KEY"          # safe for the client; RLS protects data
service_role_key = "YOUR-SERVICE-ROLE-KEY" # server-side only (CSV import); keep secret
